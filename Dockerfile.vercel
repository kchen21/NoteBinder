# syntax=docker/dockerfile:1
# check=error=true

ARG RUBY_VERSION=4.0.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim AS base

WORKDIR /rails

# Update RubyGems and Bundler
RUN gem update --system --no-document && \
    gem install -N bundler

# Install base runtime packages (ImageMagick, PostgreSQL client, jemalloc, curl, xz-utils)
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y curl imagemagick libjemalloc2 libpq5 postgresql-client xz-utils && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set production environment and default Vercel port
ENV BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    RAILS_ENV="production" \
    PORT="80"

# Install precompiled Node.js 26.13.1 binary directly
ARG NODE_VERSION=26.13.1
ENV PATH=/usr/local/node/bin:$PATH
RUN mkdir -p /usr/local/node && \
    curl -fsSL "https://nodejs.org{NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" | \
    tar -xJ -C /usr/local/node --strip-components=1


# --- Build Stage ---
FROM base AS build

# Install packages needed to build native gems and node modules
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libffi-dev libpq-dev libyaml-dev node-gyp pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV PATH="/usr/local/node/bin:$PATH"

# Install application gems using your exact Bundler version
COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v 4.0.24 && \
    BUNDLE_DEPLOYMENT=0 bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git

# Install node modules
COPY package.json package-lock.json ./
RUN npm install --force

# Copy application code
COPY . .

# Ensure binfiles are executable and use Linux line endings
RUN chmod +x bin/* && \
    sed -i "s/\r$//g" bin/* && \
    sed -i 's/ruby\.exe$/ruby/' bin/*

# Precompile assets without requiring RAILS_MASTER_KEY
RUN SECRET_KEY_BASE_DUMMY=1 ./bin/rails assets:precompile


# --- Final Stage ---
FROM base

# Copy built artifacts: gems and application
COPY --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"
COPY --from=build /rails /rails

# Run as non-root user for security
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash && \
    mkdir -p storage && \
    chown -R 1000:1000 db log storage tmp
USER 1000:1000

EXPOSE 80

# Start Puma directly on 0.0.0.0 and Vercel's $PORT
CMD ["sh", "-c", "bundle exec puma -C config/puma.rb -b tcp://0.0.0.0:${PORT:-80}"]